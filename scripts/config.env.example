# SPDX-License-Identifier: GPL-3.0-or-later
#
# Copy to /etc/aeromux-db/config.env (root:root, mode 0644). Non-secret tunables,
# all optional. Loaded by systemd as EnvironmentFile — use full-line comments only
# (systemd does NOT strip trailing/inline comments).

# Number of releases to retain when pruning (default: 10 if unset).
KEEP=10

# Release number within the current ISO week. Uncomment for a second build in the
# same week; otherwise the version's release number defaults to 1.
# RELEASE=1

# Publish target, "owner/repo". Defaults to the checkout's origin remote if unset;
# set it only to publish somewhere other than origin (e.g. a mirror).
# GH_REPO=owner/repo
