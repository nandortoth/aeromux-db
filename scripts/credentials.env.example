#
# Copy to /etc/aeromux-db/credentials.env (root:root, mode 0600). NEVER commit real
# values. Loaded by systemd as EnvironmentFile — so use full-line comments only
# (systemd does NOT strip trailing/inline comments; "KEY=val # x" makes the value
# "val # x").

# GitHub token: a fine-grained PAT scoped to THIS repository only, with
# Contents: Read and write. Required.
GH_TOKEN=github_pat_REPLACE_ME

# healthchecks.io ping URL. This is a capability (anyone with it can spoof pings),
# so it lives with the secrets. Delete this line to disable monitoring.
HEALTHCHECKS_URL=https://hc-ping.com/REPLACE_ME
